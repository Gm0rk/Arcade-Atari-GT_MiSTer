# Arcade-Atari-GT -- source manifest
#
# rtl/ is organized by hardware component:
#   rtl/          MiSTer framework helpers that came with the template
#   rtl/cpu/      MC68EC020 main CPU
#   rtl/cage/     CAGE audio board: the 68020 comm, the TMS320C31 and its
#                 memory side, the clk_sys/clk_dsp crossings
#   rtl/video/    video pipeline: playfield, alpha, motion objects, RLE,
#                 palette/colormix, timing, and the top-level video block
#   rtl/board/    board-level glue: ROM download decode, demo memories
#
# $readmemh paths are resolved relative to the project directory, not to
# the source file. Every memory-init .hex lives in mem/ and is named
# "mem/<file>.hex", so Quartus and the benches (run from the project root)
# find the same file. A missing file is only a Critical Warning and the array
# silently zero-fills, so the whole mem/ directory ships with the project.
# (mem/alpha_scene*.hex and mem/mo_vram_zero2.hex are not read by the
# synthesized build.)

# MiSTer framework helpers
set_global_assignment -name VERILOG_FILE rtl/lfsr.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cos.sv

# CPU: MC68EC020
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/m68020_flags.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/m68020_regs.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/m68020_core.sv

# CAGE audio board. Arcade-Atari-GT.sv instantiates agt_cage; everything below
# is inside it (agt_cage_boot, _ramload and _stub are under rtl/board).
# agt_c31.sv includes c31_ops.svh and c31_decode.svh (generated by
# tools/gen_c31_decode.py) through SEARCH_PATH. They are included, never
# compiled alone, so they are not listed.
set_global_assignment -name SEARCH_PATH rtl/cage
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_comm.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_c31.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_c31_fp.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_bus.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_dcache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cdc_hs.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_membridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_portmux.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_sbank.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_dac.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_gov.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_icache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_mbx_cdc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_iramxfer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_rstsync.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage_release.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cage/agt_cage.sv

# Video: RLE motion-object renderer
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_rle_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_rle_objtable.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_div32.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_rle_blit.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_rle_objlist.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_rle_renderer.sv

# Video: playfield / alpha / motion-object layers
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_tile_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_playfield_addr.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_playfield_pixel_combine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_playfield_line_render.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_alpha_tile_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_alpha_addr.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_alpha_pixel_combine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_mo_pixel_combine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_mo_vram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_tile_arb.sv

# Video: palette, colormix, timing, top.
# agt_colormix_primrage is the game-specific 3-layer blend (MAME's
# m_is_primrage path); a T-MEK variant would sit alongside it here.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_colorram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_colormix_pf_primrage.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_colormix_primrage.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_scanline_scroll.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_dbg_text.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_tile_sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_alpha_line_render.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_video_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_video.sv

# Board-level glue
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_main_memmap.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_rle_pair_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_cpu_meter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_wram_router.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/agt_scroll_race_meter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_sdram_loopback.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_prage_prot.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_irq_gen.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_board_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_rom_download.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_input_map.sv
# CAGE boot-table stream parser. List a module here as soon as it is
# instantiated: iverilog finds unlisted modules through its -y directories,
# but Quartus fails.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_cage_boot.sv
# The boot parser's words into cageram in SDRAM, through agt_sdram's cage port.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_cage_ramload.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_mo_checksum.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_nvram.sv

# CAGE main-CPU-facing comm stub: the cage.cpp protocol at 0xC00000
# (control/latch, DSP reset, both IRQ reasons), no sound. agt_cage selects it
# when a download has no DSP boot table (primrage20, T-MEK).
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_cage_stub.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board/agt_demo_memories.sv

# Project-level
set_global_assignment -name SDC_FILE Arcade-Atari-GT.sdc
set_global_assignment -name SYSTEMVERILOG_FILE Arcade-Atari-GT.sv
