<misterromdescription>
    <name>Primal Rage (version 2.3, Dec 1994)</name>
    <setname>primrageo</setname>
    <rbf>Arcade-Atari-GT-Debug</rbf>
    <!-- The DEBUG build: Arcade-Atari-GT-Debug.rbf, from
         Arcade-Atari-GT-Debug.qpf, with the OSD's Debug page and the
         overlay. The same ROMs, layout and .nvm file as the
         release .mra of this name in mra/. Written by
         tools/check_debug_build.py (its write-mra option); do
         not edit. -->
    <!-- Requires a 64 MB SDRAM module or larger: the 32 MB of RLE sprite
         data alone fills a 32 MB module before the CPU ROM, tiles, chars
         and sound are counted. On a smaller module the download aliases
         onto the CPU's own ROM and the core boots to a black screen. -->
    <year>1994</year>
    <manufacturer>Atari Games</manufacturer>
    <category>Fighter</category>
    <mratimestamp>202609200000</mratimestamp>
    <!-- Button names are the core's J1 string from Arcade-Atari-GT.sv,
         read by gen_mra.py. The firmware replaces the core's names with
         these and binds them by position, so they must match J1 exactly.
         default is the pad button each one gets before a map is defined. -->
    <buttons names="Quick High,Fierce High,Quick Low,Fierce Low,Start,Coin" default="Y,X,B,A,Start,Select"/>

    <!-- Region layout matches agt_rom_download.sv exactly (asserted by
         gen_mra.py's check_layout_against_rtl). cage:boot is streamed as
         its raw file and cage as the window of its declared region that
         the loads actually fill; both are appended after rle, because the
         decoder splits by fixed address ranges and inserting a region
         anywhere earlier would shift every later one. -->
    <!-- type="merged": these are MAME merged sets, where a clone's ROMs sit
         inside the parent zip under a subdirectory. The firmware does not
         read this attribute; each part below names its real path in the
         zip, plus its crc=. The MRA spec documents the attribute and other
         tooling uses it, so it is declared. md5="none" is spec sanctioned
         and disables the whole-ROM checksum; it stays until this core's
         stream layout is stable. -->
    <rom index="0" zip="primrage.zip" type="merged" md5="none">
        <!-- maincpu: stream 0x0000000, 0x200000 bytes -->
        <interleave output="32">
            <part name="primrageo/136102-1044b.29l" crc="35c9c34b" map="0001"/>
            <part name="primrageo/136102-1043b.28l" crc="86322829" map="0010"/>
            <part name="primrageo/136102-1042b.27l" crc="750e8095" map="0100"/>
            <part name="primrageo/136102-1041b.25l" crc="6a90d283" map="1000"/>
        </interleave>

        <!-- tiles: stream 0x0200000, 0x300000 bytes -->
        <part name="rage_136102-0050a_pf0l.25n" crc="66896e8f"/>
        <part repeat="0x80000">00</part>
        <part name="rage_136102-0051a_pf0m.27n" crc="fb5b3e7b"/>
        <part repeat="0x80000">00</part>
        <part name="rage_136102-0052a_pf0h.28n" crc="cbe38670"/>
        <part repeat="0x80000">00</part>

        <!-- chars: stream 0x0500000, 0x20000 bytes -->
        <part name="rage_136102-1078a_alpha.22p" crc="1d3260bf"/>

        <!-- proms: stream 0x0520000, 0x600 bytes -->
        <part name="136094-0001a.13s" crc="a70ade3f"/>
        <part name="136094-0002a.14s" crc="f4768b4d"/>
        <part name="136094-0003a.15s" crc="22a76ad4"/>

        <!-- pad to align rle -->
        <part repeat="0x1FA00">00</part>
        <!-- rle: stream 0x0540000, 0x2000000 bytes -->
        <interleave output="16">
            <part name="primrageo/136102-1101a.2w" crc="bb7ee624" map="01"/>
            <part name="primrageo/136102-1100a.2v" crc="6e9c80b5" map="10"/>
        </interleave>
        <part repeat="0x700000">00</part>
        <interleave output="16">
            <part name="136102-0333.moh1.0" crc="3320448e" map="01"/>
            <part name="136102-0332.mol1.0" crc="610cfcb4" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0335.moh1.1" crc="e4f6e87a" map="01"/>
            <part name="136102-0334.mol1.1" crc="be3acb6f" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0337.moh1.2" crc="73fdd050" map="01"/>
            <part name="136102-0336.mol1.2" crc="a78a8525" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0339.moh1.3" crc="e0cd1393" map="01"/>
            <part name="136102-0338.mol1.3" crc="fa19cae6" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0317.moh0.0" crc="9e3b831a" map="01"/>
            <part name="136102-0316.mol0.0" crc="9301c672" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0319.moh0.1" crc="42f22e4b" map="01"/>
            <part name="136102-0318.mol0.1" crc="8523db5d" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0321.moh0.2" crc="3b7d498a" map="01"/>
            <part name="136102-0320.mol0.2" crc="21369d13" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0323.moh0.3" crc="603f3bb6" map="01"/>
            <part name="136102-0322.mol0.3" crc="05e9f407" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0325.moh0.4" crc="f43321e3" map="01"/>
            <part name="136102-0324.mol0.4" crc="3c37769f" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0327.moh0.5" crc="9f4806d5" map="01"/>
            <part name="136102-0326.mol0.5" crc="63d4ccea" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0329.moh0.6" crc="eff3d2cd" map="01"/>
            <part name="136102-0328.mol0.6" crc="a08d73e1" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136102-0331.moh0.7" crc="c6a64dad" map="01"/>
            <part name="136102-0330.mol0.7" crc="7bf6bb8f" map="10"/>
        </interleave>

        <!-- cage:boot: stream 0x2540000, 0x80000 bytes -->
        <part name="rage_136102-1045b_dspsub.11a" crc="0656435f"/>

        <!-- cage: stream 0x25C0000, 0x400000 bytes -->
        <interleave output="32">
            <part name="primrage20/136102-0075" crc="b685a88e" map="0021"/>
            <part name="primrage20/136102-0077" crc="3283cea8" map="2100"/>
        </interleave>
    </rom>

    <!-- rom index 1 is two bytes for agt_rom_download.sv: the game
         (0 T-MEK, 1 Primal Rage) and the control panel (0 dedicated start,
         1 an attack button doubles as start), from this set's
         INPUT_PORTS(primrageo). The panel byte picks agt_input_map's
         layout. -->
    <rom index="1"><part>01 01</part></rom>

    <!-- EEPROM: eeprom_parallel_28xx, 2KB, byte wide. Without this the
         self-test settings do not survive a power cycle. -->
    <nvram index="2" size="2048"/>
</misterromdescription>
